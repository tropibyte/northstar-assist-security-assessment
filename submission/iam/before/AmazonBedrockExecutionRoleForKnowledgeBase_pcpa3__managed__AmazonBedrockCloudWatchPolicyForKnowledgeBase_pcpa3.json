{
  "arn": "arn:aws:iam::118924230273:policy/service-role/AmazonBedrockCloudWatchPolicyForKnowledgeBase_pcpa3",
  "document": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "CloudWatchWritePermissionStatement",
        "Effect": "Allow",
        "Action": [
          "cloudwatch:PutMetricData"
        ],
        "Resource": [
          "*"
        ],
        "Condition": {
          "StringEquals": {
            "cloudwatch:namespace": "AWS/Bedrock/KnowledgeBases"
          }
        }
      }
    ]
  }
}